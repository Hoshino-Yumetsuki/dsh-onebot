{
  "name": "dsh-onebot",
  "description": "OneBot v11 HTTP and WebSocket adapter for DeepSeek Harness",
  "version": "1.4.0",
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "rimraf lib && rolldown -c rolldown.config.js",
    "test": "node --run build && node --test --test-timeout=15000 tests/compatibility.test.mjs",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "prepack": "node --run lint && node --run build"
  },
  "license": "MPL-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "onebot",
    "onebot-v11"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "undici": "^7.18.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.0-beta.54",
    "rolldown-plugin-dts": "^0.18.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
